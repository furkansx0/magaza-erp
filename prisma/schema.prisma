// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums removed for SQLite compatibility

model SystemCounter {
  key   String @id
  value Int
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  group       String   // 'GENERAL', 'INVENTORY', 'POS', 'SECURITY'
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemConfig {
  id             Int      @id @default(1) // Singleton
  isInstalled    Boolean  @default(false)
  companyName    String?
  appTitle       String?  @default("Retail ERP")
  logoUrl        String?
  licenseKey     String?
  licenseStatus  String?  @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Store {
  id        String   @id @default(uuid())
  name      String
  code      String?  // "IST-001"
  location  String?
  phone     String?
  
  type      String   @default("STORE") // "STORE", "WAREHOUSE", "VIRTUAL"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  stocks    Stock[]
  sales     Sale[]
  
  transfersFrom StockTransfer[] @relation("SourceStore")
  transfersTo   StockTransfer[] @relation("TargetStore")
  stockMovements StockMovement[]
  expenses       StoreExpense[]
  cashClosings   CashRegisterClosing[]
  
  pickups        Sale[]   @relation("PickupStore")

  managerId     String? @unique
  manager       User?   @relation("StoreManager", fields: [managerId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed
  name      String?
  role      String   @default("CASHIER")
  permissions String? // JSON

  
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  
  // Explicit Manager Relation
  managedStore Store? @relation("StoreManager")
  
  salesItems SaleItem[] @relation("ItemSalesRep")
  
  sales     Sale[]   // Sales made by this user
  cashClosings CashRegisterClosing[]
  auditLogs AuditLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  isArchived Boolean @default(false)
}

model ProductModel {
  id            String   @id @default(uuid())
  name          String   // "Polo Klasik Deri Bot"
  brand         String?  // "Polo"
  description   String?
  
  // Hiyerarşik Yapı (Sahibinden.com Mantığı)
  // Katman 1: Gender (Erkek, Kadın, Çocuk) - Zaten var
  gender        String?  
  
  modelCode     String? // New: Manual Model Code
  // Katman 2: Category (Ayakkabı, Bot) - Zaten var
  category      String? 
  // Katman 3: SubCategory (Klasik, Spor, Günlük)
  subCategory   String?

  // Yeni: Sezon (2024 Yaz, 2025 Kış vb.)
  season        String?
  material      String?
  style         String?
  

  // Katman 4: Özellikler (Dynamic Attributes)
  // JSON String: {"material": "Deri", "season": "2024 Yaz", "lining": "Yün"}
  attributes    String?  
  
  isArchived    Boolean  @default(false)

  variants      ProductVariant[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        ProductImage[]
}

model ProductImage {
  id        String   @id @default(uuid())
  url       String
  color     String   // "Siyah" - Links to Variant Group Color
  
  modelId   String
  model     ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([modelId, color])
}

model ProductVariant {
  id            String   @id @default(uuid())
  barcode       String   @unique
  sku           String?  // Giyim kodu örn: GR10450-KIR-S
  
  color         String?  // "Kırmızı", "Lacivert"
  size          String?  // "S", "M", "36", "42"
  
  purchasePrice Decimal  
  salePrice     Decimal
  secondPrice   Decimal? // İndirimli fiyat vs.
  
  isArchived    Boolean  @default(false)
  
  modelId       String
  model         ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  stocks        Stock[]
  saleItems     SaleItem[]
  stockTransferItems StockTransferItem[]
  stockMovements StockMovement[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Stock {
  id        String   @id @default(uuid())
  quantity  Int      @default(0)
  
  isArchived Boolean @default(false)
  
  // Link to specific variant (Red Small), not generic model
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([variantId, storeId]) 
}

// THE LEDGER: Immutable history of every stock change
model StockMovement {
  id        String   @id @default(uuid())
  
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  
  quantity  Int      // +5 or -2
  balanceAfter Int   // Snapshot of total stock after movement (for quick verification)
  
  type      String   // "SALE", "RETURN", "TRANSFER_OUT", "TRANSFER_IN", "ADJUSTMENT", "COUNT_CORRECTION"
  reason    String?  // "Stolen", "Damaged", "Order #123"
  
  referenceId String? // SaleID, TransferID, etc.
  
  userId    String?  // Who did it?
  
  createdAt DateTime @default(now())
  
  @@index([storeId, variantId])
  @@index([createdAt])
}




